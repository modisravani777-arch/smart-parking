import React, { useEffect, useRef, useState } from 'react';
import { motion } from 'framer-motion';
import { MapPin, Navigation, ZoomIn, ZoomOut } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { useParkingData } from '@/hooks/useParkingData';
import { useToast } from '@/components/ui/use-toast';

const ParkingMap = ({ selectedParking, onSelectParking }) => {
  const mapRef = useRef(null);
  const [mapInstance, setMapInstance] = useState(null);
  const [markers, setMarkers] = useState([]);
  const { parkingZones } = useParkingData();
  const { toast } = useToast();

  // Initialize map
  useEffect(() => {
    if (!mapRef.current) return;

    // Create map container
    const L = window.L;
    if (!L) {
      console.error('Leaflet not loaded');
      return;
    }

    const map = L.map(mapRef.current).setView([40.7128, -74.0060], 14);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(map);

    setMapInstance(map);

    return () => {
      map.remove();
    };
  }, []);

  // Add markers
  useEffect(() => {
    if (!mapInstance) return;

    const L = window.L;

    // Clear existing markers
    markers.forEach(marker => marker.remove());

    // Create custom icon function
    const createIcon = (availabilityPercentage) => {
      const color = availabilityPercentage > 50 ? '#22c55e' : availabilityPercentage > 20 ? '#f59e0b' : '#ef4444';
      return L.divIcon({
        className: 'custom-marker',
        html: `
          <div style="position: relative;">
            <svg width="32" height="40" viewBox="0 0 32 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 0C7.163 0 0 7.163 0 16c0 12 16 24 16 24s16-12 16-24c0-8.837-7.163-16-16-16z" fill="${color}"/>
              <circle cx="16" cy="16" r="6" fill="white"/>
            </svg>
          </div>
        `,
        iconSize: [32, 40],
        iconAnchor: [16, 40],
        popupAnchor: [0, -40]
      });
    };

    const newMarkers = parkingZones.map(zone => {
      const availabilityPercentage = ((zone.totalSpots - zone.occupiedSpots) / zone.totalSpots) * 100;
      const marker = L.marker([zone.latitude, zone.longitude], {
        icon: createIcon(availabilityPercentage)
      }).addTo(mapInstance);

      marker.on('click', () => {
        onSelectParking(zone);
      });

      const freeSpots = zone.totalSpots - zone.occupiedSpots;
      marker.bindPopup(`
        <div style="padding: 8px;">
          <strong style="font-size: 14px;">${zone.name}</strong><br/>
          <span style="color: ${availabilityPercentage > 50 ? '#22c55e' : availabilityPercentage > 20 ? '#f59e0b' : '#ef4444'}; font-weight: bold;">
            ${freeSpots} / ${zone.totalSpots} available
          </span>
        </div>
      `);

      return marker;
    });

    setMarkers(newMarkers);

    return () => {
      newMarkers.forEach(marker => marker.remove());
    };
  }, [mapInstance, parkingZones, onSelectParking]);

  // Center on selected parking
  useEffect(() => {
    if (mapInstance && selectedParking) {
      mapInstance.setView([selectedParking.latitude, selectedParking.longitude], 16, {
        animate: true,
        duration: 0.5
      });
    }
  }, [mapInstance, selectedParking]);

  const handleZoomIn = () => {
    if (mapInstance) {
      mapInstance.zoomIn();
    }
  };

  const handleZoomOut = () => {
    if (mapInstance) {
      mapInstance.zoomOut();
    }
  };

  const handleRecenter = () => {
    if (mapInstance) {
      mapInstance.setView([40.7128, -74.0060], 14, { animate: true });
      toast({
        title: "Map recentered",
        description: "Returned to default view"
      });
    }
  };

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ duration: 0.5 }}
      className='bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden relative'
    >
      <div className='h-[600px] relative' ref={mapRef}>
        {/* Loading fallback */}
        <div className='absolute inset-0 flex items-center justify-center bg-slate-100 z-0'>
          <MapPin className='w-12 h-12 text-slate-400 animate-pulse' />
        </div>
      </div>
      
      {/* Map controls */}
      <div className='absolute top-4 right-4 flex flex-col gap-2 z-[1000]'>
        <Button
          size='icon'
          variant='secondary'
          className='bg-white hover:bg-slate-100 shadow-md'
          onClick={handleZoomIn}
        >
          <ZoomIn className='w-4 h-4' />
        </Button>
        <Button
          size='icon'
          variant='secondary'
          className='bg-white hover:bg-slate-100 shadow-md'
          onClick={handleZoomOut}
        >
          <ZoomOut className='w-4 h-4' />
        </Button>
        <Button
          size='icon'
          variant='secondary'
          className='bg-white hover:bg-slate-100 shadow-md'
          onClick={handleRecenter}
        >
          <Navigation className='w-4 h-4' />
        </Button>
      </div>

      {/* Legend */}
      <div className='absolute bottom-4 left-4 bg-white rounded-lg shadow-md p-3 z-[1000]'>
        <p className='text-xs font-semibold text-slate-700 mb-2'>Availability</p>
        <div className='space-y-1'>
          <div className='flex items-center gap-2'>
            <div className='w-3 h-3 rounded-full bg-green-500'></div>
            <span className='text-xs text-slate-600'>&gt; 50% available</span>
          </div>
          <div className='flex items-center gap-2'>
            <div className='w-3 h-3 rounded-full bg-amber-500'></div>
            <span className='text-xs text-slate-600'>20-50% available</span>
          </div>
          <div className='flex items-center gap-2'>
            <div className='w-3 h-3 rounded-full bg-red-500'></div>
            <span className='text-xs text-slate-600'>&lt; 20% available</span>
          </div>
        </div>
      </div>
    </motion.div>
  );
};

export default ParkingMap;